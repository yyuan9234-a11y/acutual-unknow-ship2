clc; clear; close all;

%% 加载实测水声信号
load('ship_2.mat');
a = z(:);

fs           = 1000;
N            = length(a);
sim_duration = (N-1) / fs;
t_data       = (0:N-1)' / fs;

%% 创建外加信号插值函数
ext_signal = @(tq) interp1(t_data, a, mod(tq, t_data(end)), 'linear', 0);

%% 设置系统初始条件
u0    = [0, 0];
tspan = [0, sim_duration];

%% 设置振子参数（完全不变）
l        = 166;
w        = 1.03^l;
f_signal = w / (2 * pi);
fprintf('当前参数: l = %d, omega_l = %.6f, f = %.4f Hz\n', l, w, f_signal);

%% 求解微分方程（完全不变）
r      = 1.088;
odefun = @(t, u) duffing(t, u, r, w, ext_signal);
[t, u] = ode45(odefun, tspan, u0);
x1     = u(:, 1);

%% 插值到精确20000点（唯一新增步骤）
t_uniform  = linspace(0, sim_duration, N)';
x1_uniform = interp1(t, x1, t_uniform, 'linear');

%% 保存输出
save('x1.mat', 'x1_uniform', 't_uniform');

%% 绘图
figure;
n = 1:length(x1_uniform);
plot(n, x1_uniform);
xlabel('n', 'FontSize', 12);
ylabel('$x$/V', 'FontSize', 12, 'Interpreter', 'latex');
grid on;
xlim([1, length(x1_uniform)]);
